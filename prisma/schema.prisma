generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String      @id @default(cuid())
  email     String      @unique
  name      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  watchlist Watchlist[]
  positions Position[]

  @@map("users")
}

model Watchlist {
  id          String   @id @default(cuid())
  userId      String
  symbol      String
  thesis      String?
  targetPrice Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@map("watchlist")
}

model OptionSnapshot {
  id             String          @id @default(cuid())
  symbol         String
  underlying     String
  stockPrice     Decimal         @db.Decimal(12, 2)
  strike         Decimal         @db.Decimal(12, 2)
  premium        Decimal         @db.Decimal(12, 2)
  expirationDate DateTime
  contractType   OptionType      @default(CALL)
  delta          Decimal?        @db.Decimal(8, 4)
  openInterest   Int?
  volume         Int?
  bid            Decimal?        @db.Decimal(12, 2)
  ask            Decimal?        @db.Decimal(12, 2)
  impliedVol     Decimal?        @db.Decimal(8, 4)
  capturedAt     DateTime        @default(now())
  scoringResults ScoringResult[]
  positions      Position[]

  @@index([underlying, expirationDate])
  @@map("option_snapshots")
}

model Position {
  id               String          @id @default(cuid())
  userId           String
  optionSnapshotId String?
  symbol           String
  underlying       String
  contracts        Int
  entryPremium     Decimal         @db.Decimal(12, 2)
  currentPremium   Decimal?        @db.Decimal(12, 2)
  strike           Decimal         @db.Decimal(12, 2)
  expirationDate   DateTime
  status           PositionStatus  @default(OPEN)
  openedAt         DateTime        @default(now())
  closedAt         DateTime?
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  optionSnapshot   OptionSnapshot? @relation(fields: [optionSnapshotId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@map("positions")
}

model ScoringResult {
  id                 String         @id @default(cuid())
  optionSnapshotId   String
  totalScore         Int
  timeScore          Int
  breakevenScore     Int
  upsideScore        Int
  efficiencyScore    Int
  moneynessScore     Int
  liquidityScore     Int
  requiredMovePct    Decimal        @db.Decimal(8, 4)
  profitAtTarget     Decimal        @db.Decimal(12, 2)
  roiPct             Decimal        @db.Decimal(8, 4)
  targetPrice        Decimal        @db.Decimal(12, 2)
  createdAt          DateTime       @default(now())
  optionSnapshot     OptionSnapshot @relation(fields: [optionSnapshotId], references: [id], onDelete: Cascade)

  @@index([totalScore])
  @@map("scoring_results")
}

model AnalystTarget {
  id          String   @id @default(cuid())
  symbol      String
  firm        String
  analystName String?
  targetPrice Decimal  @db.Decimal(12, 2)
  rating      String?
  publishedAt DateTime
  sourceUrl   String?
  createdAt   DateTime @default(now())

  @@index([symbol, publishedAt])
  @@map("analyst_targets")
}

enum OptionType {
  CALL
  PUT
}

enum PositionStatus {
  OPEN
  CLOSED
  WATCHING
}
